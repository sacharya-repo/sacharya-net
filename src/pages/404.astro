---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page is not part of sacharya.net.">
  <section class="mx-auto max-w-6xl px-5 py-28 sm:px-6">
    <p class="font-mono text-[11px] tracking-[0.18em] text-neutral-500 uppercase">404</p>
    <h1 class="mt-3 text-4xl font-medium tracking-[-0.04em] text-neutral-950 dark:text-white">
      This page is not on the map.
    </h1>
    <p class="mt-4 max-w-lg text-neutral-600 dark:text-neutral-400">
      The address does not match an essay or a case study.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex h-11 items-center rounded-full border border-neutral-300 px-5 text-sm dark:border-neutral-700"
    >
      Back to the work
    </a>
  </section>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseStudies from '../components/CaseStudies.astro';
import WritingFeed from '../components/WritingFeed.astro';
import Bio from '../components/Bio.astro';
import { writingPubDate } from '../lib/writing-meta';

const studies = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('writing')).sort(
  (a, b) => writingPubDate(b.data).valueOf() - writingPubDate(a.data).valueOf(),
);
---

<BaseLayout>
  <Hero />
  <CaseStudies studies={studies} />
  <WritingFeed posts={posts} />
  <Bio showHeadshot={false} />
</BaseLayout>

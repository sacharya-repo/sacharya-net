---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingIndexFeed from '../../components/WritingIndexFeed';
import { formatDate } from '../../lib/format';
import {
  writingDescription,
  writingPubDate,
  writingReadingTime,
} from '../../lib/writing-meta';
import { writingTopicForSlug } from '../../lib/writing-topics';

const posts = (await getCollection('writing')).sort(
  (a, b) => writingPubDate(b.data).valueOf() - writingPubDate(a.data).valueOf(),
);

const listItems = posts.map((post) => {
  const pubDate = writingPubDate(post.data);
  return {
    slug: post.id,
    title: post.data.title,
    description: writingDescription(post.data),
    dateLabel: formatDate(pubDate),
    dateTime: pubDate.toISOString(),
    readingTime: writingReadingTime(post.data),
    topicId: writingTopicForSlug(post.id),
  };
});
---

<BaseLayout
  title="Writing"
  description="Essays by Shantanu Acharya on semantic context layers, harness engineering, and pragmatic enterprise ontologies."
>
  <div class="mx-auto max-w-6xl px-5 pt-16 sm:px-6 md:pt-24">
    <p class="font-mono text-[11px] tracking-[0.18em] text-neutral-500 uppercase">Writing</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-medium tracking-[-0.04em] text-neutral-950 sm:text-5xl dark:text-white">
      Thought leadership for people who run the system.
    </h1>
  </div>
  <WritingIndexFeed
    client:visible
    posts={listItems}
    heading="Recent essays"
    lede="Essays on governed agentic systems, semantic context, and production AI—archived here and syndicated across Medium and Substack."
  />
</BaseLayout>
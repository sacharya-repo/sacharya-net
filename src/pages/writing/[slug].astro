---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const publishedTime = entry.data.pubDate.toISOString();
const canonicalUrl = new URL(`/writing/${entry.id}`, site.url).href.replace(/\/$/, '');
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  publishedTime={publishedTime}
  canonical={canonicalUrl}
>
  <article class="mx-auto max-w-3xl px-5 pt-16 pb-24 sm:px-6 md:pt-24">
    <a
      href="/writing"
      class="font-mono text-[11px] tracking-[0.16em] text-neutral-500 uppercase hover:text-neutral-950 dark:hover:text-white"
    >
      Writing
    </a>
    <h1 class="mt-5 text-4xl leading-[1.08] font-medium tracking-[-0.04em] text-neutral-950 sm:text-5xl dark:text-white">
      {entry.data.title}
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-neutral-600 dark:text-neutral-400">
      {entry.data.description}
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-neutral-200 py-4 dark:border-neutral-800">
      <time
        datetime={entry.data.pubDate.toISOString()}
        class="font-mono text-[11px] tracking-[0.12em] text-neutral-500 uppercase"
      >
        {formatDate(entry.data.pubDate)}
      </time>
      <span class="font-mono text-[11px] tracking-[0.12em] text-neutral-500 uppercase">
        {entry.data.readingTime}
      </span>
      {
        entry.data.sourceUrl && (
          <a
            href={entry.data.sourceUrl}
            target="_blank"
            rel="noreferrer"
            class="font-mono text-[11px] tracking-[0.12em] text-neutral-500 uppercase underline decoration-neutral-300 underline-offset-4 hover:text-neutral-950 dark:decoration-neutral-700 dark:hover:text-white"
          >
            Published on Medium
          </a>
        )
      }
      <ul class="flex flex-wrap gap-2">
        {
          entry.data.tags.map((tag) => (
            <li class="rounded-full border border-neutral-200 px-2.5 py-1 font-mono text-[10px] tracking-[0.14em] text-neutral-500 uppercase dark:border-neutral-800">
              {tag}
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="prose prose-site prose-neutral dark:prose-invert mt-10 max-w-none prose-headings:font-medium prose-headings:tracking-[-0.03em] prose-a:font-medium prose-a:underline prose-a:decoration-neutral-300 prose-a:underline-offset-4 dark:prose-a:decoration-neutral-700"
    >
      <Content />
    </div>
  </article>
</BaseLayout>

---
import CopyEmail from './CopyEmail';
import SocialLinks from './SocialLinks.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 dark:border-neutral-800">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-16 sm:px-6 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-mono text-[11px] tracking-[0.18em] text-neutral-500 uppercase">Contact</p>
      <p class="mt-3 max-w-md text-2xl font-medium tracking-[-0.03em] text-neutral-950 dark:text-white">
        A direct line for architecture conversations.
      </p>
      <div class="mt-6">
        <CopyEmail client:load />
      </div>
    </div>
    <div class="flex flex-col items-start gap-4 md:items-end">
      <SocialLinks
        ariaLabelledSection="Connect with Shantanu Acharya"
        reposPlacement="up"
        reposAlign="end"
      />
      <p class="font-mono text-[11px] tracking-[0.08em] text-neutral-500 uppercase">
        © {year} {site.name}
      </p>
    </div>
  </div>
</footer>

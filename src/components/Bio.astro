---
import FadeIn from './FadeIn';
import Headshot from './Headshot.astro';
import { affiliations, executiveBio, focusAreas, honors, speakingTopics } from '../data/site';

const columns = [
  { title: 'Core Focus Areas', items: focusAreas },
  { title: 'Advisory & Speaking Topics', items: speakingTopics },
  { title: 'Honors & Recognition', items: honors },
  { title: 'Affiliations', items: affiliations },
];
---

<section id="about" class="scroll-mt-24 border-t border-neutral-200 dark:border-neutral-800">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 md:py-28">
    <FadeIn client:visible>
      <p class="font-mono text-[11px] tracking-[0.18em] text-neutral-500 uppercase">03 — Practice</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-medium tracking-[-0.035em] text-neutral-950 sm:text-4xl dark:text-white">
        Enterprise engineering, applied to production AI.
      </h2>
      <div class="mt-10 grid gap-10 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-12 lg:grid-cols-[16.5rem_minmax(0,1fr)]">
        <div class="flex justify-center md:justify-start">
          <Headshot variant="bio" class="md:sticky md:top-28" />
        </div>
        <div class="max-w-3xl space-y-5 text-base leading-relaxed text-neutral-600 dark:text-neutral-400">
          {executiveBio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </FadeIn>
    <FadeIn client:visible className="mt-14">
      <div class="grid gap-10 border-t border-neutral-200 pt-10 sm:grid-cols-2 lg:grid-cols-4 dark:border-neutral-800">
        {
          columns.map((column) => (
            <div>
              <h3 class="font-mono text-[11px] tracking-[0.16em] text-neutral-500 uppercase">{column.title}</h3>
              <ul class="mt-5 space-y-3">
                {column.items.map((item) => (
                  <li class="text-sm leading-relaxed text-neutral-800 dark:text-neutral-200">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </FadeIn>
  </div>
</section>
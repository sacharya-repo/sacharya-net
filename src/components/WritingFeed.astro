---
import type { CollectionEntry } from 'astro:content';
import FadeIn from './FadeIn';
import { formatDate } from '../lib/format';

interface Props {
  posts: CollectionEntry<'writing'>[];
  heading?: string;
  lede?: string;
  showIndex?: boolean;
}

const {
  posts,
  heading = 'Notes on systems, not prompts.',
  lede = 'Essays on the architecture required to run agents inside a real enterprise.',
  showIndex = true,
} = Astro.props;
---

<section id="writing" class="scroll-mt-24 border-t border-neutral-200 dark:border-neutral-800">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-6 md:py-28">
    <FadeIn client:visible>
      <div class="mb-10 flex flex-col gap-4 md:mb-14 md:flex-row md:items-end md:justify-between">
        <div>
          {
            showIndex && (
              <p class="font-mono text-[11px] tracking-[0.18em] text-neutral-500 uppercase">02 — Writing</p>
            )
          }
          <h2 class="mt-3 max-w-xl text-3xl font-medium tracking-[-0.035em] text-neutral-950 sm:text-4xl dark:text-white">
            {heading}
          </h2>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{lede}</p>
        </div>
        {
          showIndex && (
            <a
              href="/writing"
              class="text-sm text-neutral-600 underline decoration-neutral-300 underline-offset-4 hover:text-neutral-950 dark:text-neutral-400 dark:decoration-neutral-700 dark:hover:text-white"
            >
              All essays
            </a>
          )
        }
      </div>
    </FadeIn>
    <ol class="border-t border-neutral-200 dark:border-neutral-800">
      {
        posts.map((post, index) => (
          <li>
            <FadeIn client:visible delay={index * 0.04}>
              <a
                href={`/writing/${post.id}`}
                class="group grid gap-3 border-b border-neutral-200 py-6 md:grid-cols-[8.5rem_1fr_auto] md:items-baseline md:gap-8 dark:border-neutral-800"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="font-mono text-[11px] tracking-[0.12em] text-neutral-500 uppercase"
                >
                  {formatDate(post.data.pubDate)}
                </time>
                <span>
                  <span class="block text-lg font-medium tracking-[-0.02em] text-neutral-950 group-hover:underline group-hover:decoration-neutral-300 group-hover:underline-offset-4 dark:text-white dark:group-hover:decoration-neutral-700">
                    {post.data.title}
                  </span>
                  <span class="mt-2 block max-w-2xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
                    {post.data.description}
                  </span>
                </span>
                <span class="font-mono text-[11px] tracking-[0.12em] text-neutral-500 uppercase">
                  {post.data.readingTime}
                </span>
              </a>
            </FadeIn>
          </li>
        ))
      }
    </ol>
  </div>
</section>

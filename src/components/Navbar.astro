---
import ThemeToggle from './ThemeToggle';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;

function isActive(href: string) {
  return path === href || path.startsWith(`${href}/`);
}
---

<header
  class="sticky top-0 z-50 border-b border-neutral-200/80 bg-[#f4f3ef]/75 backdrop-blur-xl dark:border-neutral-800/80 dark:bg-[#09090b]/70 relative"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5 text-neutral-950 dark:text-white">
      <span class="font-mono text-[11px] tracking-[0.2em] text-neutral-500">{site.monogram}</span>
      <span class="text-sm font-medium tracking-[-0.02em]">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'text-sm transition',
              isActive(item.href)
                ? 'text-neutral-950 dark:text-white'
                : 'text-neutral-500 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle client:load />
      <a
        href={`mailto:${site.email}`}
        class="hidden h-9 items-center rounded-full border border-neutral-900 bg-neutral-950 px-3.5 text-[13px] font-medium text-white transition hover:bg-neutral-800 sm:inline-flex dark:border-white dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200"
      >
        Get in Touch
      </a>
      <details class="md:hidden">
        <summary
          class="inline-flex h-9 cursor-pointer items-center rounded-full border border-neutral-200 px-3 text-[13px] text-neutral-800 dark:border-neutral-800 dark:text-neutral-100"
        >
          <span class="details-closed">Menu</span>
          <span class="details-open">Close</span>
        </summary>
        <div
          class="absolute inset-x-0 top-full z-50 border-b border-neutral-200 bg-[#f4f3ef] px-5 py-4 shadow-lg dark:border-neutral-800 dark:bg-[#09090b]"
        >
          <nav class="mx-auto flex max-w-6xl flex-col gap-1" aria-label="Mobile">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class="rounded-xl px-3 py-2.5 text-sm text-neutral-700 hover:bg-white dark:text-neutral-200 dark:hover:bg-neutral-900"
                >
                  {item.label}
                </a>
              ))
            }
            <a
              href={`mailto:${site.email}`}
              class="mt-1 rounded-xl bg-neutral-950 px-3 py-2.5 text-center text-sm text-white dark:bg-white dark:text-neutral-950"
            >
              Get in Touch
            </a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  details:not([open]) .details-open,
  details[open] .details-closed {
    display: none;
  }
</style>

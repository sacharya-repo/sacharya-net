---
import type { CollectionEntry } from 'astro:content';
import BentoGrid from './BentoGrid';
import FadeIn from './FadeIn';

interface Props {
  studies: CollectionEntry<'case-studies'>[];
  intro?: boolean;
}

const { studies, intro = true } = Astro.props;

const cards = studies.map((study, index) => ({
  href: `/case-studies/${study.id}`,
  title: study.data.title,
  summary: study.data.summary,
  tags: study.data.tags,
  index: String(index + 1).padStart(2, '0'),
  featured: index === 0,
  metrics: study.data.metrics,
}));
---

<section
  id="architecture"
  class:list={[
    'scroll-mt-24',
    intro && 'border-t border-neutral-200 dark:border-neutral-800',
  ]}
>
  <div
    class:list={[
      'mx-auto max-w-6xl px-5 sm:px-6',
      intro ? 'py-20 md:py-28' : 'pt-12 pb-20 md:pb-28',
    ]}
  >
    {
      intro && (
        <FadeIn client:visible>
          <div class="mb-10 flex flex-col gap-4 md:mb-14 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="font-mono text-[11px] tracking-[0.18em] text-neutral-500 uppercase">01 — Selected impact</p>
          <h2 class="mt-3 max-w-xl text-3xl font-medium tracking-[-0.035em] text-neutral-950 sm:text-4xl dark:text-white">
            Architecture that survives contact with production.
          </h2>
        </div>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a
            href="/demos"
            class="text-sm text-neutral-600 underline decoration-neutral-300 underline-offset-4 hover:text-neutral-950 dark:text-neutral-400 dark:decoration-neutral-700 dark:hover:text-white"
          >
            Interactive demos
          </a>
          <a
            href="/case-studies"
            class="text-sm text-neutral-600 underline decoration-neutral-300 underline-offset-4 hover:text-neutral-950 dark:text-neutral-400 dark:decoration-neutral-700 dark:hover:text-white"
          >
            All case studies
          </a>
        </div>
          </div>
        </FadeIn>
      )
    }
    <BentoGrid client:visible studies={cards} />
    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      <a
        href="/demos/ruleweaver"
        class="group flex flex-col justify-between gap-6 rounded-2xl border border-neutral-200 bg-white/75 p-6 sm:flex-row sm:items-end dark:border-neutral-800 dark:bg-neutral-950/50"
      >
        <div>
          <p class="font-mono text-[11px] tracking-[0.18em] text-neutral-500 uppercase">Interactive demos</p>
          <h3 class="mt-3 text-xl font-medium tracking-[-0.03em] text-neutral-950 dark:text-white">RuleWeaver</h3>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
            Run a claims decision through the registry. Allow, escalate, or deny, in the browser, with a ledger you can read.
          </p>
        </div>
        <span class="text-sm text-neutral-600 underline decoration-neutral-300 underline-offset-4 group-hover:text-neutral-950 dark:text-neutral-400 dark:decoration-neutral-700 dark:group-hover:text-white">
          Open
        </span>
      </a>
      <a
        href="/demos/dq-control"
        class="group flex flex-col justify-between gap-6 rounded-2xl border border-neutral-200 bg-white/75 p-6 sm:flex-row sm:items-end dark:border-neutral-800 dark:bg-neutral-950/50"
      >
        <div>
          <p class="font-mono text-[11px] tracking-[0.18em] text-neutral-500 uppercase">Interactive demos</p>
          <h3 class="mt-3 text-xl font-medium tracking-[-0.03em] text-neutral-950 dark:text-white">DQ Control</h3>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
            Run a batch through the data-quality gate. Promote, quarantine, or reject, in the browser, before a row reaches the released view.
          </p>
        </div>
        <span class="text-sm text-neutral-600 underline decoration-neutral-300 underline-offset-4 group-hover:text-neutral-950 dark:text-neutral-400 dark:decoration-neutral-700 dark:group-hover:text-white">
          Open
        </span>
      </a>
    </div>
  </div>
</section>
